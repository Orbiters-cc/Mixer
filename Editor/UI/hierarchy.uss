/* Mixer Hierarchy: dense rows on the Logger's greys, Mixer's green for the selection, violet for Blender. */

.mxh-root { background-color: var(--mx-bg); }
.mxh-topbar { height: 34px; min-height: 34px; flex-direction: row; align-items: center; padding: 0 6px 0 8px; background-color: var(--mx-bar); border-bottom-width: 1px; border-bottom-color: var(--mx-line); flex-shrink: 0; }
.mxh-search { flex-grow: 1; margin: 0 4px 0 0; }
.mxh-search .unity-base-text-field__input, .mxh-search .unity-text-field__input { min-height: 24px; height: 24px; padding-left: 26px; padding-right: 76px; border-radius: 8px; }
/* The kind filters' menu, at the end of the search field. */
.mxh-filter { height: 18px; flex-direction: row; align-items: center; margin: 0 0 0 3px; padding: 0 7px 0 6px; border-width: 0; border-radius: 6px; background-color: rgba(255, 255, 255, 0.06); background-image: none; scale: 1 1; transition-property: background-color, scale; transition-duration: 0.12s, 0.16s; transition-timing-function: ease-out, ease-out-back; }
.mxh-filter:hover { background-color: rgba(255, 255, 255, 0.12); }
.mxh-filter.mx-pressed { scale: 0.94 0.94; }
.mxh-filter__icon { width: 11px; height: 11px; margin-right: 4px; --icon-color: #9a9a9a; }
.mxh-filter__text { margin: 0; padding: 0; font-size: 10px; color: #b5b5b5; -unity-font-style: bold; }
.mxh-filter__count { margin: 0 0 0 4px; padding: 0 4px; min-width: 14px; height: 13px; border-radius: 7px; font-size: 9px; -unity-font-style: bold; -unity-text-align: middle-center; color: #0f1a14; background-color: #3cf29a; }
.mxh-filter--on, .mxh-filter--on:hover { background-color: rgba(0, 218, 109, 0.16); }
.mxh-filter--on .mxh-filter__text { color: #3cf29a; }
.mxh-filter--on .mxh-filter__icon { --icon-color: #3cf29a; }
.mxh-search__icon { position: absolute; left: 8px; top: 5px; width: 14px; height: 14px; --icon-color: #8a8a8a; }
.mxh-add { width: 24px; height: 24px; min-width: 24px; }
.mxh-chips { flex-direction: row; flex-wrap: wrap; padding: 4px 6px 2px 8px; background-color: var(--mx-bar); border-bottom-width: 1px; border-bottom-color: var(--mx-line); flex-shrink: 0; }
.mxh-chip { flex-direction: row; align-items: center; height: 20px; margin: 0 4px 3px 0; padding: 0 8px 0 6px; border-width: 0; border-radius: 10px; background-color: rgba(255, 255, 255, 0.05); background-image: none; scale: 1 1; transition-property: background-color, scale; transition-duration: 0.12s, 0.16s; transition-timing-function: ease-out, ease-out-back; }
.mxh-chip:hover { background-color: rgba(255, 255, 255, 0.1); }
.mxh-chip.mx-pressed { scale: 0.94 0.94; }
.mxh-chip__icon { width: 11px; height: 11px; margin-right: 4px; --icon-color: #9a9a9a; }
.mxh-chip__text { margin: 0; padding: 0; font-size: 10px; color: #b5b5b5; -unity-font-style: bold; }
.mxh-chip--on, .mxh-chip--on:hover { background-color: rgba(0, 218, 109, 0.16); }
.mxh-chip--on .mxh-chip__text { color: #3cf29a; }
.mxh-chip--on .mxh-chip__icon { --icon-color: #3cf29a; }

.mxh-list { flex-grow: 1; }
.mxh-row { flex-direction: row; align-items: center; padding-right: 4px; border-bottom-width: 0; }
.mxh-row--odd { background-color: rgba(255, 255, 255, 0.012); }
.mxh-row:hover { background-color: var(--mx-hover); }
.mxh-row--selected, .mxh-row--selected:hover { background-color: rgba(0, 218, 109, 0.16); }
/* A bone sub-selected in Weight Paint: Mixer's pick, lighter than Unity's selection, its name in the accent. */
.mxh-row.mxh-row--subselected, .mxh-row.mxh-row--subselected:hover { background-color: rgba(0, 218, 109, 0.09); }
.mxh-row.mxh-row--subselected .mxh-row__name { color: #3cf29a; -unity-font-style: bold; }
.mxh-row--scene { background-color: #343434; border-bottom-width: 1px; border-bottom-color: var(--mx-line); }
.mxh-row--scene:hover { background-color: #3a3a3a; }
.mxh-row__indent { flex-shrink: 0; }
.mxh-row__chevron { width: 18px; height: 18px; min-width: 18px; margin: 0; }
.mxh-row__chevron .mx-icon { width: 10px; height: 10px; --icon-color: #8a8a8a; transition-property: rotate; transition-duration: 0.12s; }
.mxh-row__chevron--open .mx-icon { rotate: 90deg; }
.mxh-row__dot { width: 7px; height: 7px; border-radius: 4px; margin: 0 6px 0 2px; border-width: 1px; border-color: rgba(255, 255, 255, 0.22); background-color: rgba(0, 0, 0, 0); flex-shrink: 0; }
.mxh-row__dot--linked { border-width: 0; background-color: var(--mx-accent); }
.mxh-row__dot--excluded { border-width: 0; background-color: #5a5a5a; }
.mxh-row__dot--owned { border-width: 0; background-color: var(--mx-violet); }
.mxh-row__icon { width: 16px; height: 16px; margin-right: 5px; flex-shrink: 0; }
.mxh-row__name { margin: 0; padding: 0; color: #e2e2e2; font-size: 12px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex-shrink: 1; }
.mxh-row--scene .mxh-row__name { -unity-font-style: bold; color: #f0f0f0; }
.mxh-row__name--active-scene { color: #ffffff; }
.mxh-row--dim .mxh-row__name { color: #7f7f7f; }
.mxh-row--prefab .mxh-row__name { color: #8fbaff; }
.mxh-row--prefab.mxh-row--dim .mxh-row__name { color: #5f7ea8; }
.mxh-row--missing .mxh-row__name { color: #ff8a8a; }
.mxh-row--excluded .mxh-row__name { color: #9a9a9a; }
.mxh-row__rename { margin: 0 4px 0 0; flex-grow: 1; }
.mxh-row__rename .unity-base-text-field__input { min-height: 20px; height: 20px; padding: 0 6px; border-radius: 6px; background-color: #1f1f1f; }
.mxh-row__badges { flex-direction: row; align-items: center; margin-left: 6px; }
.mxh-badge { margin: 0 3px 0 0; padding: 0 5px; height: 14px; border-radius: 7px; font-size: 9px; -unity-font-style: bold; color: #8fbaff; background-color: rgba(143, 186, 255, 0.14); -unity-text-align: middle-center; }
.mxh-badge--missing { color: #ff8a8a; background-color: rgba(255, 107, 107, 0.16); }
.mxh-badge--mixer { color: #3cf29a; background-color: rgba(0, 218, 109, 0.14); }
.mxh-row__components { flex-direction: row; align-items: center; margin-right: 4px; }
.mxh-row__component { width: 14px; height: 14px; margin-left: 2px; opacity: 0.75; }
.mxh-row__more { margin: 0 0 0 2px; padding: 0; font-size: 10px; color: #7c7c7c; }
.mxh-row__pick, .mxh-row__eye { width: 20px; height: 20px; min-width: 20px; margin: 0; opacity: 0; }
.mxh-row:hover .mxh-row__pick, .mxh-row:hover .mxh-row__eye, .mxh-row__switch--off { opacity: 1; }
.mxh-row__pick .mx-icon, .mxh-row__eye .mx-icon { width: 12px; height: 12px; --icon-color: #9a9a9a; }
.mxh-row__switch--off .mx-icon { --icon-color: #f5b74f; }
.mxh-row--hidden .mxh-row__name { opacity: 0.6; }
.mxh-dragline { position: absolute; right: 2px; height: 2px; border-radius: 1px; background-color: var(--mx-accent); }
.mxh-dragline--onto { background-color: rgba(0, 218, 109, 0.2); border-radius: 6px; }
.mxh-footer { height: 22px; min-height: 22px; padding: 0 10px; -unity-text-align: middle-left; color: #8c8c8c; font-size: 10px; background-color: var(--mx-bar); border-top-width: 1px; border-top-color: var(--mx-line); flex-shrink: 0; }
.mxh-root--compact .mxh-row__icon { width: 14px; height: 14px; }
.mxh-root--compact .mxh-row__name { font-size: 11px; }
.mxh-root .mx-toasts { bottom: 30px; }

/* Rich rows: an active switch, a picture of the meshes (or a light's turning ball) and a second line. */
.mxh-row__active { width: 13px; height: 13px; min-width: 13px; margin: 0 6px 0 0; border-radius: 4px; border-width: 1px; border-color: rgba(255, 255, 255, 0.2); background-color: rgba(0, 0, 0, 0); align-items: center; justify-content: center; flex-shrink: 0; transition-property: background-color, border-color; transition-duration: 0.1s; }
.mxh-row__active:hover { border-color: rgba(255, 255, 255, 0.42); }
.mxh-row__active-check { width: 9px; height: 9px; --icon-color: #d8d8d8; opacity: 0; }
.mxh-row__active--on { background-color: rgba(255, 255, 255, 0.1); border-color: rgba(255, 255, 255, 0); }
.mxh-row__active--on .mxh-row__active-check { opacity: 1; }
.mxh-row--selected .mxh-row__active--on .mxh-row__active-check { --icon-color: #3cf29a; }
.mxh-row__picture { flex-direction: row; align-items: center; justify-content: center; flex-shrink: 0; margin-right: 5px; }
.mxh-row--picture .mxh-row__picture { width: 40px; height: 40px; margin-right: 8px; }
.mxh-row__thumbnail { width: 40px; height: 40px; }
.mxh-row__glyph { width: 14px; height: 14px; margin: 1px; --icon-color: #b4b4b4; }
.mxh-row--selected .mxh-row__glyph { --icon-color: #3cf29a; }
.mxh-row__thumbnail--waiting { opacity: 0.55; }
.mxh-row__sphere { margin: 0 2px 0 6px; }
.mxh-row__sphere .orb-sphere__ball { width: 38px; height: 38px; border-radius: 19px; }
.mxh-row__sphere .orb-sphere__readout { display: none; }
.mxh-row__body { flex-grow: 1; flex-shrink: 1; flex-direction: column; justify-content: center; overflow: hidden; }
.mxh-row__line { flex-direction: row; align-items: center; min-height: 20px; }
.mxh-row__line2 { flex-direction: row; align-items: center; height: 18px; margin-top: 1px; padding-right: 4px; }
.mxh-row__detail { margin: 0; padding: 0; font-size: 10px; color: #8c8c8c; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex-shrink: 1; }
.mxh-row__detail--short { max-width: 45%; margin-right: 6px; }
.mxh-row--selected .mxh-row__detail { color: #a7c9b6; }
.mxh-row__extras { flex-direction: row; align-items: center; flex-grow: 1; flex-shrink: 1; overflow: hidden; }
.mxh-row__vrchat { margin: 0 5px 0 1px; }
.mxh-drop { flex-direction: column; align-items: center; justify-content: center; flex-shrink: 0; width: 132px; height: 40px; margin: 0 2px 0 6px; padding: 0 8px; border-radius: 6px; border-width: 0; background-color: rgba(0, 0, 0, 0.12); transition-property: background-color; transition-duration: 0.12s; }
.mxh-drop:hover { background-color: rgba(255, 255, 255, 0.04); }
.mxh-drop--over, .mxh-drop--over:hover { background-color: rgba(0, 218, 109, 0.12); }
.mxh-drop__icon { width: 12px; height: 12px; margin-bottom: 3px; --icon-color: #8a8a8a; }
.mxh-drop--over .mxh-drop__icon, .mxh-drop--busy .mxh-drop__icon { --icon-color: #3cf29a; }
.mxh-drop__text { margin: 0; padding: 0; font-size: 10px; color: #9a9a9a; -unity-font-style: bold; }
.mxh-drop--busy .mxh-drop__text, .mxh-drop--over .mxh-drop__text { color: #3cf29a; }
.mxh-bones { flex-direction: row; align-items: center; overflow: hidden; flex-shrink: 0; }
.mxh-row__line > .mxh-bones { margin-left: 8px; }
.mxh-bone { height: 16px; min-height: 16px; margin: 0 3px 0 0; padding: 0 7px; border-width: 0; border-radius: 8px; background-color: rgba(255, 255, 255, 0.06); background-image: none; font-size: 9px; -unity-font-style: bold; color: #c8c8c8; scale: 1 1; transition-property: background-color, scale; transition-duration: 0.12s, 0.16s; transition-timing-function: ease-out, ease-out-back; }
.mxh-bone:hover { background-color: rgba(255, 255, 255, 0.12); color: #ffffff; }
.mxh-bone.mx-pressed { scale: 0.92 0.92; background-color: rgba(0, 218, 109, 0.22); color: #3cf29a; }
.mxh-bone:disabled { opacity: 0.35; }
.mxh-refit { height: 18px; min-height: 18px; margin: 0; padding: 0 9px; font-size: 10px; }
.mxh-root--compact .mxh-row__active { width: 11px; height: 11px; min-width: 11px; }

/* A VRChat avatar's row: three lines, a larger picture with VRChat's logo on it, the drop field as tall. */
.mxh-row--avatar .mxh-row__picture { width: 60px; height: 60px; margin-right: 8px; }
.mxh-row--avatar .mxh-row__thumbnail { width: 60px; height: 60px; }
.mxh-row--avatar .mxh-drop { height: 60px; }
.mxh-row__vrchat-mark { position: absolute; left: -2px; bottom: 0; width: 30px; height: 15px; }
.mxh-avatar { flex-direction: column; justify-content: center; overflow: hidden; }
.mxh-avatar__line { flex-direction: row; align-items: center; height: 18px; margin-top: 1px; padding-right: 4px; overflow: hidden; }
.mxh-avatar__name { margin: 0; padding: 0; font-size: 11px; color: #c8c8c8; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex-shrink: 1; }
.mxh-avatar__name--note { font-size: 10px; color: #8c8c8c; }
.mxh-avatar__base { margin: 0 0 0 6px; padding: 0 6px; height: 15px; border-radius: 7px; font-size: 9px; -unity-font-style: bold; -unity-text-align: middle-center; color: #b9b1ff; background-color: rgba(138, 125, 255, 0.16); flex-shrink: 0; }
.mxh-avatar__fact { flex-direction: row; align-items: center; margin-right: 10px; flex-shrink: 0; }
.mxh-avatar__rank-icon { width: 14px; height: 14px; margin-right: 4px; }
.mxh-avatar__fact-icon { width: 11px; height: 11px; margin-right: 4px; --icon-color: #9a9a9a; }
.mxh-avatar__fact-text { margin: 0; padding: 0; font-size: 10px; color: #a8a8a8; }
.mxh-avatar__link { width: 18px; height: 18px; min-width: 18px; margin: 0; }
.mxh-avatar__link .mx-icon { width: 11px; height: 11px; --icon-color: #9a9a9a; }
.mxh-row--selected .mxh-avatar__name, .mxh-row--selected .mxh-avatar__fact-text { color: #a7c9b6; }
/* The visibility and picking switches at the row's right end (light and avatar rows). */
.mxh-row__switches { flex-direction: row; align-items: center; flex-shrink: 0; }
.mxh-row--switches-right .mxh-row__switches { margin-left: 4px; }
