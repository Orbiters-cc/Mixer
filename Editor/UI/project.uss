/* Mixer Project: the Hierarchy's greys and density, Mixer's green for what is selected, a side panel for uses. */

.mxp-root { background-color: var(--mx-bg); }
.mxp-topbar { height: 34px; min-height: 34px; flex-direction: row; align-items: center; padding: 0 6px 0 8px; background-color: var(--mx-bar); border-bottom-width: 1px; border-bottom-color: var(--mx-line); flex-shrink: 0; }
.mxp-search { flex-grow: 1; flex-shrink: 1; min-width: 80px; margin: 0 4px 0 0; }
.mxp-search .unity-base-text-field__input, .mxp-search .unity-text-field__input { min-height: 24px; height: 24px; padding-left: 26px; padding-right: 76px; border-radius: 8px; }
.mxp-search__icon { position: absolute; left: 8px; top: 5px; width: 14px; height: 14px; --icon-color: #8a8a8a; }
.mxp-filter { position: absolute; right: 3px; top: 3px; height: 18px; flex-direction: row; align-items: center; margin: 0; padding: 0 7px 0 6px; border-width: 0; border-radius: 6px; background-color: rgba(255, 255, 255, 0.06); background-image: none; scale: 1 1; transition-property: background-color, scale; transition-duration: 0.12s, 0.16s; transition-timing-function: ease-out, ease-out-back; }
.mxp-filter:hover { background-color: rgba(255, 255, 255, 0.12); }
.mxp-filter.mx-pressed { scale: 0.94 0.94; }
.mxp-filter__icon { width: 11px; height: 11px; margin-right: 4px; --icon-color: #9a9a9a; }
.mxp-filter__text { margin: 0; padding: 0; font-size: 10px; color: #b5b5b5; -unity-font-style: bold; }
.mxp-filter__count { margin: 0 0 0 4px; padding: 0 4px; min-width: 14px; height: 13px; border-radius: 7px; font-size: 9px; -unity-font-style: bold; -unity-text-align: middle-center; color: #0f1a14; background-color: #3cf29a; }
.mxp-filter--on, .mxp-filter--on:hover { background-color: rgba(0, 218, 109, 0.16); }
.mxp-filter--on .mxp-filter__text { color: #3cf29a; }
.mxp-filter--on .mxp-filter__icon { --icon-color: #3cf29a; }
/* The sort menu and the create buttons: flat, the Hierarchy's chip look. */
.mxp-sort { height: 24px; flex-direction: row; align-items: center; margin: 0 4px 0 0; padding: 0 8px 0 7px; border-width: 0; border-radius: 8px; background-color: rgba(255, 255, 255, 0.05); background-image: none; flex-shrink: 0; scale: 1 1; transition-property: background-color, scale; transition-duration: 0.12s, 0.16s; transition-timing-function: ease-out, ease-out-back; }
.mxp-sort:hover { background-color: rgba(255, 255, 255, 0.1); }
.mxp-sort.mx-pressed { scale: 0.94 0.94; }
.mxp-sort__icon { width: 12px; height: 12px; margin-right: 5px; --icon-color: #9a9a9a; }
.mxp-sort__text { margin: 0; padding: 0; font-size: 10px; color: #c2c2c2; -unity-font-style: bold; }
.mxp-create { flex-direction: row; align-items: center; flex-shrink: 0; padding: 0 0 0 4px; border-left-width: 1px; border-left-color: rgba(255, 255, 255, 0.07); }
.mxp-create__button { width: 26px; height: 24px; min-width: 26px; margin: 0 0 0 2px; padding: 0; border-width: 0; border-radius: 7px; background-color: rgba(0, 0, 0, 0); background-image: none; align-items: center; justify-content: center; scale: 1 1; transition-property: background-color, scale; transition-duration: 0.12s, 0.16s; transition-timing-function: ease-out, ease-out-back; }
.mxp-create__button:hover { background-color: var(--mx-hover); }
.mxp-create__button.mx-pressed { background-color: var(--mx-press); scale: 0.9 0.9; }
.mxp-create__button:disabled { opacity: 0.35; }
.mxp-create__icon { width: 16px; height: 16px; }
.mxp-create__plus { position: absolute; right: 2px; bottom: 2px; width: 9px; height: 9px; padding: 1px; border-radius: 5px; background-color: var(--mx-bar); --icon-color: #3cf29a; }
.mxp-create__button:hover .mxp-create__plus { background-color: #444444; }

.mxp-split { flex-grow: 1; }
.mxp-split > .unity-two-pane-split-view__dragline-anchor { background-color: var(--mx-line); width: 1px; }
.mxp-left { flex-grow: 1; min-width: 120px; background-color: var(--mx-surface); }
.mxp-right { flex-grow: 1; min-width: 160px; flex-direction: column; }
.mxp-tree { flex-grow: 1; padding-top: 3px; }

/* The folder tree. */
.mxp-trow { flex-direction: row; align-items: center; padding: 0 6px 0 4px; margin: 0 4px; border-radius: 6px; }
.mxp-trow:hover { background-color: var(--mx-hover); }
.mxp-trow--current, .mxp-trow--current:hover { background-color: rgba(0, 218, 109, 0.16); }
.mxp-trow--current .mxp-trow__name { color: #ffffff; }
.mxp-trow--drop, .mxp-trow--drop:hover { background-color: rgba(0, 218, 109, 0.24); }
.mxp-trow__indent { flex-shrink: 0; }
.mxp-trow__chevron { width: 16px; height: 18px; min-width: 16px; margin: 0; }
.mxp-trow__chevron .mx-icon { width: 9px; height: 9px; --icon-color: #8a8a8a; transition-property: rotate; transition-duration: 0.12s; }
.mxp-trow__chevron--open .mx-icon { rotate: 90deg; }
.mxp-trow__icon { width: 16px; height: 16px; margin-right: 5px; flex-shrink: 0; }
.mxp-trow__glyph { width: 14px; height: 14px; margin: 0 6px 0 1px; flex-shrink: 0; --icon-color: #3cf29a; }
.mxp-trow__name { margin: 0; padding: 0; color: #d6d6d6; font-size: 12px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex-shrink: 1; }
.mxp-trow--root .mxp-trow__name { -unity-font-style: bold; color: #e8e8e8; }

/* The path bar over the right pane. */
.mxp-pathbar { height: 28px; min-height: 28px; flex-direction: row; align-items: center; padding: 0 4px 0 8px; background-color: var(--mx-surface); border-bottom-width: 1px; border-bottom-color: var(--mx-line); flex-shrink: 0; }
.mxp-crumbs { flex-direction: row; align-items: center; flex-shrink: 1; overflow: hidden; }
.mxp-crumb { height: 20px; min-width: 20px; margin: 0; padding: 0 6px; border-width: 0; border-radius: 6px; background-color: rgba(0, 0, 0, 0); background-image: none; font-size: 11px; color: #a8a8a8; flex-shrink: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; -unity-text-align: middle-left; }
.mxp-crumb:hover { background-color: var(--mx-hover); color: #ffffff; }
.mxp-crumb.mx-pressed { background-color: var(--mx-press); }
.mxp-crumb--current { color: #f0f0f0; -unity-font-style: bold; flex-shrink: 0; }
Label.mxp-crumb { padding-top: 3px; }
.mxp-crumb__separator { width: 8px; height: 8px; margin: 0 1px; flex-shrink: 0; --icon-color: #6a6a6a; }
.mxp-crumb__glyph { width: 13px; height: 13px; margin: 0 2px 0 2px; flex-shrink: 0; --icon-color: #3cf29a; }
.mxp-tool { width: 24px; height: 22px; min-width: 24px; margin: 0 0 0 1px; }
.mxp-tool .mx-icon { width: 13px; height: 13px; --icon-color: #9a9a9a; }
.mxp-tool--on, .mxp-tool--on:hover { background-color: rgba(0, 218, 109, 0.16); }
.mxp-tool--on .mx-icon, .mxp-tool--on:hover .mx-icon { --icon-color: #3cf29a; }

.mxp-panes { flex-grow: 1; flex-direction: row; }
.mxp-column { flex-grow: 1; flex-shrink: 1; min-width: 120px; }
.mxp-content { flex-grow: 1; }
.mxp-content--drop { background-color: rgba(0, 218, 109, 0.07); }
.mxp-empty { position: absolute; left: 0; right: 0; top: 40px; margin: 0; padding: 0 20px; -unity-text-align: middle-center; white-space: normal; font-size: 11px; color: #7c7c7c; }

/* The right pane's lines. */
.mxp-row { flex-direction: row; align-items: center; padding: 0 4px 0 4px; }
.mxp-row--odd { background-color: rgba(255, 255, 255, 0.012); }
.mxp-row:hover { background-color: var(--mx-hover); }
.mxp-row--picked, .mxp-row--picked:hover { background-color: rgba(0, 218, 109, 0.16); }
.mxp-row--drop, .mxp-row--drop:hover { background-color: rgba(0, 218, 109, 0.24); }
.mxp-row--ping, .mxp-row--ping:hover { background-color: rgba(245, 183, 79, 0.22); transition-property: background-color; transition-duration: 0.3s; }
.mxp-row__indent { flex-shrink: 0; }
.mxp-row__chevron { width: 18px; height: 18px; min-width: 18px; margin: 0; }
.mxp-row__chevron .mx-icon { width: 10px; height: 10px; --icon-color: #8a8a8a; transition-property: rotate; transition-duration: 0.12s; }
.mxp-row__chevron--open .mx-icon { rotate: 90deg; }
.mxp-row__picture { flex-direction: row; align-items: center; justify-content: center; flex-shrink: 0; margin-right: 5px; }
.mxp-row__icon { width: 16px; height: 16px; }
.mxp-row__body { flex-grow: 1; flex-shrink: 1; flex-direction: column; justify-content: center; overflow: hidden; }
.mxp-row__line { flex-direction: row; align-items: center; min-height: 20px; }
.mxp-row__line2 { flex-direction: row; align-items: center; height: 16px; margin-top: 0; padding-right: 4px; overflow: hidden; }
.mxp-row__name { margin: 0; padding: 0; color: #e2e2e2; font-size: 12px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex-shrink: 1; }
.mxp-row--folder .mxp-row__name { color: #ececec; }
.mxp-row__ext { margin: 0 0 0 1px; padding: 0; font-size: 11px; color: #6f6f6f; flex-shrink: 0; }
.mxp-row--picked .mxp-row__ext { color: #7fa892; }
.mxp-new { margin: 0 0 0 6px; padding: 0 5px; height: 14px; border-radius: 7px; font-size: 9px; -unity-font-style: bold; -unity-text-align: middle-center; color: #3cf29a; background-color: rgba(0, 218, 109, 0.14); flex-shrink: 0; }
.mxp-row__rename { margin: 0 4px 0 0; flex-grow: 1; }
.mxp-row__rename .unity-base-text-field__input { min-height: 20px; height: 20px; padding: 0 6px; border-radius: 6px; background-color: #1f1f1f; }
.mxp-row__date { margin: 0 2px 0 8px; padding: 0; font-size: 10px; color: #7c7c7c; flex-shrink: 0; white-space: nowrap; }
.mxp-row--picked .mxp-row__date { color: #a7c9b6; }
.mxp-row__target { width: 20px; height: 20px; min-width: 20px; margin: 0; opacity: 0; }
.mxp-row:hover .mxp-row__target, .mxp-row--picked .mxp-row__target, .mxp-row__target--on { opacity: 1; }
.mxp-row__target .mx-icon { width: 12px; height: 12px; --icon-color: #9a9a9a; }
.mxp-row__target--on .mx-icon, .mxp-row__target--busy .mx-icon { --icon-color: #3cf29a; }
.mxp-row__target--busy { background-color: rgba(0, 218, 109, 0.14); }
.mxp-row__match { margin: 0 6px 0 0; padding: 0 5px; height: 13px; border-radius: 6px; font-size: 9px; -unity-font-style: bold; -unity-text-align: middle-center; color: #b9b1ff; background-color: rgba(138, 125, 255, 0.16); flex-shrink: 0; }
.mxp-row__detail { margin: 0; padding: 0; font-size: 10px; color: #8c8c8c; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex-shrink: 1; }
.mxp-row--picked .mxp-row__detail { color: #a7c9b6; }
/* Section headings in the recent list and the search. */
.mxp-row--heading, .mxp-row--heading:hover { background-color: rgba(0, 0, 0, 0); padding-left: 10px; }
.mxp-row--heading .mxp-row__name { font-size: 10px; -unity-font-style: bold; color: #8c8c8c; padding-top: 4px; }

/* Where an asset is used. */
.mxp-usages { width: 290px; min-width: 220px; flex-shrink: 0; flex-direction: column; background-color: var(--mx-surface); border-left-width: 1px; border-left-color: var(--mx-line); }
.mxp-usages__header { flex-direction: row; align-items: center; min-height: 44px; padding: 6px 4px 6px 10px; border-bottom-width: 1px; border-bottom-color: var(--mx-line); }
.mxp-usages__icon { width: 16px; height: 16px; margin-right: 8px; flex-shrink: 0; --icon-color: #3cf29a; }
.mxp-usages__titles { flex-grow: 1; flex-shrink: 1; overflow: hidden; }
.mxp-usages__title { margin: 0; padding: 0; font-size: 12px; -unity-font-style: bold; color: #f0f0f0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.mxp-usages__subtitle { margin: 2px 0 0 0; padding: 0; font-size: 10px; color: #8c8c8c; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.mxp-usages__button { width: 22px; height: 22px; min-width: 22px; margin: 0 0 0 1px; }
.mxp-usages__button .mx-icon { width: 11px; height: 11px; --icon-color: #9a9a9a; }
.mxp-usages__list { flex-grow: 1; }
.mxp-usages__list .unity-scroll-view__content-container { padding: 4px 0 8px 0; }
.mxp-usages__group { flex-direction: row; align-items: center; padding: 8px 10px 3px 12px; }
.mxp-usages__group-name { margin: 0; padding: 0; font-size: 10px; -unity-font-style: bold; color: #8c8c8c; }
.mxp-usages__group-count { margin: 0 0 0 6px; padding: 0 5px; height: 13px; border-radius: 6px; font-size: 9px; -unity-font-style: bold; -unity-text-align: middle-center; color: #b5b5b5; background-color: rgba(255, 255, 255, 0.07); }
.mxp-use { flex-direction: row; align-items: center; margin: 1px 6px; padding: 5px 8px 5px 6px; border-radius: 7px; scale: 1 1; transition-property: background-color, scale; transition-duration: 0.1s, 0.14s; transition-timing-function: ease-out, ease-out-back; }
.mxp-use:hover { background-color: var(--mx-hover); }
.mxp-use.mx-pressed { background-color: var(--mx-press); scale: 0.98 0.98; }
.mxp-use--on, .mxp-use--on:hover { background-color: rgba(0, 218, 109, 0.16); }
.mxp-use__icon { width: 16px; height: 16px; margin-right: 8px; flex-shrink: 0; }
.mxp-use__texts { flex-grow: 1; flex-shrink: 1; overflow: hidden; }
.mxp-use__title { margin: 0; padding: 0; font-size: 11px; color: #e2e2e2; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.mxp-use__detail { margin: 1px 0 0 0; padding: 0; font-size: 10px; color: #8c8c8c; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.mxp-use--on .mxp-use__detail { color: #a7c9b6; }
.mxp-usages__more { margin: 6px 12px; font-size: 10px; color: #7c7c7c; }

/* The status bar: counts on the left, the icon size slider on the right (all the way left: the list). */
.mxp-footer { height: 22px; min-height: 22px; flex-direction: row; align-items: center; padding: 0 8px 0 10px; background-color: var(--mx-bar); border-top-width: 1px; border-top-color: var(--mx-line); flex-shrink: 0; }
.mxp-footer__text { flex-grow: 1; flex-shrink: 1; margin: 0; padding: 0; -unity-text-align: middle-left; color: #8c8c8c; font-size: 10px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.mxp-size { width: 88px; margin: 0 0 0 8px; flex-shrink: 0; }
.mxp-size .unity-base-slider__drag-container { min-height: 14px; }
/* Track and dot both centred on the slider's middle line. */
.mxp-size .unity-base-slider__tracker { position: absolute; left: 0; right: 0; top: 50%; height: 4px; margin-top: -2px; border-radius: 2px; border-width: 0; background-color: #4c4c4c; }
.mxp-size .unity-base-slider__dragger { position: absolute; top: 50%; width: 10px; height: 10px; margin-top: -5px; border-radius: 5px; border-width: 0; background-color: #c8c8c8; }
.mxp-size .unity-base-slider__dragger-border { display: none; }
.mxp-size:hover .unity-base-slider__dragger { background-color: #ffffff; }

/* The icon grid. */
.mxp-grid { flex-grow: 1; }
.mxp-gline { flex-direction: row; align-items: flex-start; padding: 2px 6px 0 6px; }
.mxp-gline__heading { margin: 0; padding: 6px 4px 0 4px; font-size: 10px; -unity-font-style: bold; color: #8c8c8c; }
.mxp-tile { flex-direction: column; align-items: center; margin: 0 2px; padding: 4px 4px 0 4px; border-radius: 8px; flex-shrink: 0; }
.mxp-tile:hover { background-color: var(--mx-hover); }
.mxp-tile--picked, .mxp-tile--picked:hover { background-color: rgba(0, 218, 109, 0.16); }
.mxp-tile--drop, .mxp-tile--drop:hover { background-color: rgba(0, 218, 109, 0.24); }
.mxp-tile--ping, .mxp-tile--ping:hover { background-color: rgba(245, 183, 79, 0.22); }
.mxp-tile__picture { align-items: center; justify-content: center; flex-shrink: 0; }
.mxp-tile__image { width: 100%; height: 100%; }
.mxp-tile--folder .mxp-tile__image { width: 78%; height: 78%; }
.mxp-tile__name { width: 100%; margin: 4px 0 0 0; padding: 0 2px; font-size: 11px; color: #e2e2e2; -unity-text-align: upper-center; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.mxp-tile--picked .mxp-tile__name { color: #ffffff; }
.mxp-tile__new { position: absolute; left: 4px; top: 4px; margin: 0; }
.mxp-tile__target { position: absolute; right: 3px; top: 3px; width: 20px; height: 20px; min-width: 20px; margin: 0; border-radius: 6px; background-color: rgba(28, 28, 28, 0.78); opacity: 0; }
.mxp-tile:hover .mxp-tile__target, .mxp-tile--picked .mxp-tile__target, .mxp-tile__target.mxp-row__target--on { opacity: 1; }
.mxp-tile__target .mx-icon { width: 12px; height: 12px; --icon-color: #c8c8c8; }
.mxp-tile__target.mxp-row__target--on .mx-icon, .mxp-tile__target.mxp-row__target--busy .mx-icon { --icon-color: #3cf29a; }
.mxp-tile__rename { width: 100%; margin: 3px 0 0 0; }
.mxp-tile__rename .unity-base-text-field__input { min-height: 18px; height: 18px; padding: 0 4px; border-radius: 5px; background-color: #1f1f1f; font-size: 11px; }
.mxp-root .mx-toasts { bottom: 30px; }
