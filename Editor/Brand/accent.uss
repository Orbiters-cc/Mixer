/* Mixer's accent colour (Orbiters settings > Mixer). MixerAccent.Apply puts .mixer-accent on each Mixer root, and
   .mixer-accent--<choice> for any choice but green; the styles read the colour, its shades and its tints from
   these variables. Written by the accent script: change the choices in MixerAccent.cs and here together. */

.mixer-accent {
    --mixer-accent: #00da6d;
    --mixer-accent-hover: #1ee57f;
    --mixer-accent-text: #3cf29a;
    --mixer-accent-text-hover: #5cf7aa;
    --mixer-accent-light: #7ff0b6;
    --mixer-accent-muted: #9adbb8;
    --mixer-accent-on: #06140c;
    --mixer-accent-dark: #0a8a4a;
    --mixer-accent-a07: rgba(0, 218, 109, 0.07);
    --mixer-accent-a08: rgba(0, 218, 109, 0.08);
    --mixer-accent-a09: rgba(0, 218, 109, 0.09);
    --mixer-accent-a10: rgba(0, 218, 109, 0.1);
    --mixer-accent-a12: rgba(0, 218, 109, 0.12);
    --mixer-accent-a13: rgba(0, 218, 109, 0.13);
    --mixer-accent-a14: rgba(0, 218, 109, 0.14);
    --mixer-accent-a15: rgba(0, 218, 109, 0.15);
    --mixer-accent-a16: rgba(0, 218, 109, 0.16);
    --mixer-accent-a17: rgba(0, 218, 109, 0.17);
    --mixer-accent-a18: rgba(0, 218, 109, 0.18);
    --mixer-accent-a20: rgba(0, 218, 109, 0.2);
    --mixer-accent-a22: rgba(0, 218, 109, 0.22);
    --mixer-accent-a23: rgba(0, 218, 109, 0.23);
    --mixer-accent-a24: rgba(0, 218, 109, 0.24);
    --mixer-accent-a26: rgba(0, 218, 109, 0.26);
    --mixer-accent-a30: rgba(0, 218, 109, 0.3);
    --mixer-accent-a32: rgba(0, 218, 109, 0.32);
    --mixer-accent-a35: rgba(0, 218, 109, 0.35);
    --mixer-accent-a40: rgba(0, 218, 109, 0.4);
    --mixer-accent-a45: rgba(0, 218, 109, 0.45);
    --mixer-accent-a50: rgba(0, 218, 109, 0.5);
    --mixer-accent-a55: rgba(0, 218, 109, 0.55);
