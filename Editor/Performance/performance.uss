/* Mixer's performance import: the Mixer window's stylesheet (mixer.uss) plus a session list. Same greys, green and
   radii: frames at 16 px, cards at 12 px, lists and fields at 8-9 px, pills at 14 px. */

.mx-perf-sessions { margin: 2px 0 6px 0; padding: 2px 0; border-radius: 9px; background-color: var(--mx-field); }
.mx-perf-session { min-height: 44px; padding: 6px 8px 6px 12px; border-radius: 8px; margin: 1px 3px; align-items: center; }
.mx-perf-session:hover { background-color: var(--mx-hover); }
.mx-perf-session--selected { background-color: var(--mixer-accent-a10); }
.mx-perf-session--selected:hover { background-color: var(--mixer-accent-a14); }
.mx-perf-session__texts { flex-grow: 1; flex-shrink: 1; overflow: hidden; }
.mx-perf-session__name { margin: 0; padding: 0; font-size: 12px; color: #eaeaea; -unity-font-style: bold; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.mx-perf-session__detail { margin: 2px 0 0 0; padding: 0; font-size: 11px; color: var(--mx-text-3); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.mx-perf-session__chips { flex-shrink: 0; margin-left: 8px; }
.mx-perf-session__chips .mx-chip { margin: 0 0 0 4px; }
.mx-root--s .mx-perf-session__chips { display: none; }
.mx-perf-empty { margin: 0; padding: 10px 12px; font-size: 11px; color: var(--mx-text-3); white-space: normal; }
.mx-perf-actions { margin: 2px 0 2px 0; }
.mx-perf-info { margin: 2px 0 4px 2px; white-space: normal; }
.mx-perf-warning { margin: 6px 0 0 2px; padding: 0; font-size: 11px; color: var(--mx-warning); white-space: normal; }
.mx-perf-kit__buttons .mx-button { margin-left: 6px; }

/* Object fields as in the Capture window (capture.uss): flat, dark, 8 px corners. */
.mx-objectfield { width: 210px; flex-grow: 0; flex-shrink: 1; margin: 0 4px 0 0; }
.mx-objectfield > .unity-base-field__label { display: none; }
.mx-objectfield .unity-object-field__input { min-height: 26px; padding: 0 0 0 6px; border-radius: 8px; background-color: var(--mx-field); border-color: var(--mx-field-border); }
.mx-objectfield .unity-object-field-display__label { color: #eaeaea; }
.mx-objectfield .unity-object-field__selector { border-radius: 0 8px 8px 0; background-color: rgba(255, 255, 255, 0.04); border-width: 0; }
